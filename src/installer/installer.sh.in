#!/usr/bin/env bash
# =============================================================================
#  Audiobook Studio - self-contained installer for macOS on Apple Silicon
#  Developed by Scott Albretsen, TSAL Solutions LLC
#  Version @@VERSION@@ (build @@BUILD_ID@@)
#
#  Installs a local, autonomous audiobook production studio:
#    web UI + durable queue + Qwen3-TTS (mlx-audio) narration + mlx-whisper QA +
#    review workspace + FFmpeg mastering (WAV/MP3/chapter-marked M4B) + release signoff.
#
#  Usage:   bash install_audiobook_studio_claude.sh [options]
#           cd ~/audiobook-studio-claude && ./start-studio      # http://127.0.0.1:7861
#
#  Safe to re-run: manuscripts, generated audio, the database, voices, settings, queue
#  state and exports are never removed. Previous application code is backed up.
#  All application code is embedded below; nothing is fetched except public Python
#  packages (PyPI), Homebrew packages and public model weights (Hugging Face).
#  This file is generated by tools/build_installer.py - edit the sources, not this file.
# =============================================================================
set -Eeuo pipefail
umask 022

STUDIO_VERSION="@@VERSION@@"
BUILD_ID="@@BUILD_ID@@"
APP_HOME="${AUDIOBOOK_STUDIO_HOME:-$HOME/audiobook-studio-claude}"
NO_MODELS=0
PREFETCH_ALL=0
SKIP_TESTS=0
STOP_RUNNING=0
EXTRACT_ONLY=""
PORT=""
LAN=0
HOST=""
ADMIN_USER="admin"
INSTALL_SERVICE=0

usage() {
  cat <<'USAGE'
Audiobook Studio installer

Options:
  --no-models        Do not pre-download model weights (they download on first use).
  --prefetch-all     Also pre-download the Base (cloning) and VoiceDesign models (~9 GB more).
  --skip-tests       Do not run the automated test suite after installing.
  --port N           Web UI port (default 7861; applied to settings).
  --stop-running     Stop a running studio before upgrading it.
  --lan              Serve on the local network: bind 0.0.0.0, default port 8080, sign-in required.
  --host ADDR        Bind address (default 127.0.0.1; --lan sets 0.0.0.0).
  --admin-user NAME  Administrator account created on first install (default: admin). A random
                     password is generated, printed once and saved to config/initial-admin-password.txt.
  --install-service  Install and start the background service (macOS LaunchAgent).
  --extract-only DIR Only write the application files into DIR/app (no venv, no downloads).
  -h, --help         Show this help.

Environment:
  AUDIOBOOK_STUDIO_HOME   Install location (default ~/audiobook-studio-claude).
  STUDIO_PYTHON           Python 3.12 interpreter to use (default: Homebrew python@3.12).
                          If set, and ffmpeg/ffprobe are already on PATH (or in $AUDIOBOOK_STUDIO_HOME/tools/bin),
                          Homebrew is not required.
  STUDIO_MLX_AUDIO_SPEC   Override the mlx-audio requirement (default mlx-audio==0.6.3).
  AUDIOBOOK_STUDIO_ALLOW_NON_MAC=1  Allow a mock-engine test install on Linux (CI only).
USAGE
}

while [ $# -gt 0 ]; do
  case "$1" in
    --no-models) NO_MODELS=1 ;;
    --prefetch-all) PREFETCH_ALL=1 ;;
    --skip-tests) SKIP_TESTS=1 ;;
    --stop-running) STOP_RUNNING=1 ;;
    --lan) LAN=1 ;;
    --install-service) INSTALL_SERVICE=1 ;;
    --host) [ $# -ge 2 ] || { echo "--host needs a value" >&2; exit 2; }; HOST="$2"; shift ;;
    --admin-user) [ $# -ge 2 ] || { echo "--admin-user needs a value" >&2; exit 2; }; ADMIN_USER="$2"; shift ;;
    --port)
      [ $# -ge 2 ] || { echo "--port needs a value" >&2; exit 2; }
      PORT="$2"; shift
      case "$PORT" in ''|*[!0-9]*) echo "--port must be a number" >&2; exit 2 ;; esac
      if [ "$PORT" -lt 1024 ] || [ "$PORT" -gt 65535 ]; then echo "--port must be 1024-65535" >&2; exit 2; fi ;;
    --extract-only)
      [ $# -ge 2 ] || { echo "--extract-only needs a directory" >&2; exit 2; }
      EXTRACT_ONLY="$2"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

if [ -t 1 ]; then B=$'\033[1m'; BL=$'\033[1;34m'; Y=$'\033[1;33m'; R=$'\033[1;31m'; G=$'\033[1;32m'; N=$'\033[0m'; else B=""; BL=""; Y=""; R=""; G=""; N=""; fi
say()  { printf '\n%s==>%s %s%s%s\n' "$BL" "$N" "$B" "$*" "$N"; }
info() { printf '    %s\n' "$*"; }
warn() { printf '%sWarning:%s %s\n' "$Y" "$N" "$*" >&2; }
die()  { printf '%sError:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }

# ----------------------------------------------------------------------------- embedded files
extract_files() {
  local DEST="$1"
  mkdir -p "$DEST"
@@EMBEDDED_FILES@@
}

verify_manifest() {
  local dir="$1"
  if command -v shasum >/dev/null 2>&1; then
    (cd "$dir" && shasum -a 256 -c MANIFEST.sha256 >/dev/null)
  elif command -v sha256sum >/dev/null 2>&1; then
    (cd "$dir" && sha256sum -c MANIFEST.sha256 >/dev/null)
  else
    warn "No shasum/sha256sum available; skipping the integrity check."
  fi
}

if [ -n "$EXTRACT_ONLY" ]; then
  extract_files "$EXTRACT_ONLY/app"
  verify_manifest "$EXTRACT_ONLY/app" || die "Integrity check of the extracted files failed."
  echo "Application files written to $EXTRACT_ONLY/app (integrity verified)."
  exit 0
fi

# ----------------------------------------------------------------------------- checks
OS="$(uname -s)"
ARCH="$(uname -m)"
IS_MAC_ARM=0
STAGE=""
BACKUP=""
SWAPPED=0
LOCK=""

preflight() {
  say "Checking this machine"
  if [ "$OS" = "Darwin" ]; then
    if [ "$(sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)" = "1" ]; then
      die "This terminal runs under Rosetta (x86_64 emulation). Open a native Terminal and run the installer again."
    fi
    [ "$ARCH" = "arm64" ] || die "Apple Silicon (arm64) is required for local MLX inference; this Mac reports $ARCH."
    IS_MAC_ARM=1
    local mem_gb
    mem_gb=$(( $(sysctl -n hw.memsize) / 1073741824 ))
    info "macOS $(sw_vers -productVersion) · $(sysctl -n machdep.cpu.brand_string 2>/dev/null || echo 'Apple Silicon') · ${mem_gb} GB unified memory"
    if [ "$mem_gb" -lt 32 ]; then warn "Less than 32 GB memory: keep Settings > Models > 'Models kept loaded' at 1."; fi
  else
    [ "${AUDIOBOOK_STUDIO_ALLOW_NON_MAC:-0}" = "1" ] || die "This installer targets macOS on Apple Silicon. (CI only: set AUDIOBOOK_STUDIO_ALLOW_NON_MAC=1 for a mock-engine test install on $OS.)"
    warn "Non-Mac install on $OS/$ARCH: MLX is unavailable, so the studio runs the MOCK engine (synthetic test tones, not narration)."
  fi
}

find_brew() {
  local b
  for b in /opt/homebrew/bin/brew /usr/local/bin/brew "$(command -v brew 2>/dev/null || true)"; do
    if [ -n "$b" ] && [ -x "$b" ]; then echo "$b"; return 0; fi
  done
  return 1
}

ensure_tools() {
  if [ "$IS_MAC_ARM" = 1 ]; then
    local BREW=""
    export PATH="$APP_HOME/tools/bin:$PATH"
    if BREW="$(find_brew)"; then
      eval "$("$BREW" shellenv)"
    elif [ -n "${STUDIO_PYTHON:-}" ] && command -v ffmpeg >/dev/null 2>&1 && command -v ffprobe >/dev/null 2>&1; then
      info "Homebrew not found; using STUDIO_PYTHON and the ffmpeg already on PATH."
    else
      die "Homebrew is required (https://brew.sh) - or provide STUDIO_PYTHON (a Python 3.12) plus ffmpeg/ffprobe on PATH. Install Homebrew with:
    /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\"
then run this installer again."
    fi
    if [ -z "${STUDIO_PYTHON:-}" ]; then
      if ! "$BREW" list --versions python@3.12 >/dev/null 2>&1; then
        say "Installing Python 3.12 with Homebrew"
        "$BREW" install python@3.12
      fi
      STUDIO_PYTHON="$("$BREW" --prefix python@3.12)/bin/python3.12"
    fi
    if { ! command -v ffmpeg >/dev/null 2>&1 || ! command -v ffprobe >/dev/null 2>&1; } && [ -n "$BREW" ]; then
      say "Installing FFmpeg with Homebrew"
      "$BREW" install ffmpeg
    fi
  else
    if [ -z "${STUDIO_PYTHON:-}" ]; then
      STUDIO_PYTHON="$(command -v python3.12 2>/dev/null || command -v python3 2>/dev/null || true)"
    fi
    command -v ffmpeg >/dev/null 2>&1 || die "ffmpeg is not installed (use your package manager)."
  fi
  [ -n "${STUDIO_PYTHON:-}" ] && [ -x "$STUDIO_PYTHON" ] || die "Python 3.12 not found (STUDIO_PYTHON='${STUDIO_PYTHON:-}')."
  command -v ffprobe >/dev/null 2>&1 || die "ffprobe is not installed (it ships with FFmpeg)."
  PYVER="$("$STUDIO_PYTHON" -c 'import sys; print("%d.%d" % sys.version_info[:2])')"
  case "$PYVER" in
    3.12) ;;
    3.11|3.13) warn "Python $PYVER found; 3.12 is the tested version." ;;
    *) die "Python 3.12 is required (found $PYVER at $STUDIO_PYTHON)." ;;
  esac
  info "Python $PYVER: $STUDIO_PYTHON"
  info "$(ffmpeg -hide_banner -version 2>/dev/null | head -n 1)"
  local avail_kb
  avail_kb="$(df -Pk "$HOME" | awk 'NR==2 {print $4}')"
  if [ -n "$avail_kb" ] && [ "$avail_kb" -lt 26214400 ]; then
    warn "Only $((avail_kb / 1048576)) GB free in $HOME. Models need ~6-15 GB; each finished audiobook needs several GB of intermediate audio."
  fi
}

check_running() {
  local f pid
  for f in "$APP_HOME/run/server.pid" "$APP_HOME/run/worker.pid"; do
    [ -f "$f" ] || continue
    pid="$(cat "$f" 2>/dev/null || true)"
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      if [ "$STOP_RUNNING" = 1 ] && [ -x "$APP_HOME/stop-studio" ]; then
        say "Stopping the running studio"
        "$APP_HOME/stop-studio"
        return 0
      fi
      die "Audiobook Studio is running (pid $pid). Stop it first with $APP_HOME/stop-studio, or re-run with --stop-running."
    fi
  done
}

on_exit() {
  if [ -n "$STAGE" ] && [ -d "$STAGE" ]; then rm -rf "$STAGE"; fi
  if [ -n "$LOCK" ] && [ -d "$LOCK" ]; then rmdir "$LOCK" 2>/dev/null || true; fi
}

on_error() {
  local rc=$?
  trap - ERR
  if [ "$SWAPPED" = 1 ] && [ -n "$BACKUP" ] && [ -d "$BACKUP" ]; then
    warn "Installation failed; restoring the previous application code from $BACKUP"
    rm -rf "$APP_HOME/app"
    mv "$BACKUP" "$APP_HOME/app"
    install_launchers || true
  fi
  printf '%sInstallation failed (exit %s).%s Your manuscripts, audio, database, voices, settings and exports were not modified.\n' "$R" "$rc" "$N" >&2
  exit "$rc"
}

install_launchers() {
  local f
  for f in start-studio stop-studio studio studio-service run-tests smoke-test; do
    cp "$APP_HOME/app/bin/$f" "$APP_HOME/$f"
    chmod 755 "$APP_HOME/$f"
  done
  cp "$APP_HOME/app/bin/_env.sh" "$APP_HOME/_env.sh"
  chmod 644 "$APP_HOME/_env.sh"
  cp "$APP_HOME/app/README.md" "$APP_HOME/README.md"
  cp "$APP_HOME/app/MODEL_LICENSES.md" "$APP_HOME/MODEL_LICENSES.md"
}

set_server_settings() {
  "$VENV/bin/python" - "$APP_HOME/config/settings.json" "$1" "$2" "$3" <<'PY'
import json, os, sys
path, host, port, remote = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4] == "1"
data = json.load(open(path)) if os.path.exists(path) else {}
srv = data.setdefault("server", {})
if host:
    srv["host"] = host
    srv["allow_remote"] = remote
if port:
    srv["port"] = int(port)
tmp = path + ".tmp"
with open(tmp, "w") as fh:
    fh.write(json.dumps(data, indent=2) + "\n")
os.replace(tmp, path)
PY
}

ensure_admin() {
  local users
  users="$(cd "$APP_HOME/app" && AUDIOBOOK_STUDIO_HOME="$APP_HOME" "$VENV/bin/python" -m studio auth list 2>/dev/null | wc -l | tr -d ' ')"
  if [ "$users" = "0" ]; then
    local out pwfile="$APP_HOME/config/initial-admin-password.txt"
    out="$(cd "$APP_HOME/app" && AUDIOBOOK_STUDIO_HOME="$APP_HOME" "$VENV/bin/python" -m studio auth add-user "$ADMIN_USER" --role admin --generate)"
    GENERATED_PW="${out##*Generated password: }"
    ( umask 077; printf 'user: %s\npassword: %s\n(delete this file after you have stored the password; change it in the UI via Password)\n' "$ADMIN_USER" "$GENERATED_PW" > "$pwfile" )
    info "Created administrator '$ADMIN_USER' (initial password saved to $pwfile)"
  else
    info "Existing user accounts kept ($users)."
  fi
}

lan_addresses() {
  if [ "$OS" = "Darwin" ]; then
    ifconfig 2>/dev/null | awk '/^[a-z0-9]+:/{i=$1} /inet /&&$2!="127.0.0.1"{print $2}'
  else
    hostname -I 2>/dev/null | tr ' ' '\n' | grep -v '^$' || true
  fi
}

prefetch_models() {
  say "Downloading model weights (first install only; resumable, public Hugging Face repos)"
  local models before after
  models="$("$VENV/bin/python" - "$APP_HOME/config/settings.json" "$PREFETCH_ALL" <<'PY'
import json, sys
m = json.load(open(sys.argv[1])).get("models", {})
ids = [m.get("custom_voice_model", "mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-bf16"), m.get("asr_model", "mlx-community/whisper-large-v3-turbo")]
if sys.argv[2] == "1":
    ids += [m.get("base_model", "mlx-community/Qwen3-TTS-12Hz-1.7B-Base-bf16"), m.get("voice_design_model", "mlx-community/Qwen3-TTS-12Hz-1.7B-VoiceDesign-bf16")]
print(" ".join(i for i in ids if not i.startswith("/")))
PY
)"
  before="$({ du -sk "$HF_HOME" 2>/dev/null || echo 0; } | cut -f1)"
  # shellcheck disable=SC2086
  if HF_HUB_DISABLE_TELEMETRY=1 "$VENV/bin/python" - $models <<'PY'
import sys, time
from huggingface_hub import snapshot_download
for repo in sys.argv[1:]:
    t0 = time.time()
    print(f"    fetching {repo} ...", flush=True)
    path = snapshot_download(repo)
    print(f"    ok ({time.time() - t0:.0f}s): {path}", flush=True)
PY
  then
    after="$({ du -sk "$HF_HOME" 2>/dev/null || echo 0; } | cut -f1)"
    info "Downloaded $(( (after - before) / 1024 )) MB this run; model cache is now $(( after / 1024 )) MB at $HF_HOME"
    echo "$(date '+%Y-%m-%d %H:%M:%S') models=[$models] downloaded_kb=$((after - before)) cache_kb=$after" >> "$APP_HOME/logs/model-downloads.log"
    [ "$PREFETCH_ALL" = 1 ] || info "Base (cloning) and VoiceDesign models download on first use (or re-run with --prefetch-all)."
  else
    warn "Model download did not complete (network?). The studio downloads models on first use; you can also re-run the installer."
  fi
}

# ----------------------------------------------------------------------------- main
main() {
  preflight
  ensure_tools
  mkdir -p "$APP_HOME/config" "$APP_HOME/data" "$APP_HOME/logs" "$APP_HOME/run" "$APP_HOME/backups" "$APP_HOME/library" "$APP_HOME/cache/huggingface"
  check_running
  LOCK="$APP_HOME/run/install.lock"
  mkdir "$LOCK" 2>/dev/null || { LOCK=""; die "Another installation seems to be running (remove $APP_HOME/run/install.lock if not)."; }
  trap on_exit EXIT
  trap on_error ERR
  export HF_HOME="${HF_HOME:-$APP_HOME/cache/huggingface}"
  export HF_HUB_DISABLE_TELEMETRY=1 DO_NOT_TRACK=1
  local TS
  TS="$(date +%Y%m%d-%H%M%S)"

  say "Unpacking Audiobook Studio $STUDIO_VERSION (build $BUILD_ID) into $APP_HOME"
  [ -d "$APP_HOME/app" ] && info "Existing installation found: upgrading code only (data, settings and library are preserved)."
  STAGE="$APP_HOME/.app-stage-$$"
  rm -rf "$STAGE"
  extract_files "$STAGE"
  verify_manifest "$STAGE" || die "Integrity check of the unpacked files failed."

  say "Preparing the Python environment"
  VENV="$APP_HOME/venv"
  if [ -x "$VENV/bin/python" ]; then
    local cur
    cur="$("$VENV/bin/python" -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null || echo none)"
    if [ "$cur" != "$PYVER" ]; then info "Rebuilding the virtualenv (Python $cur -> $PYVER)"; rm -rf "$VENV"; fi
  fi
  [ -x "$VENV/bin/python" ] || "$STUDIO_PYTHON" -m venv "$VENV"
  "$VENV/bin/python" -m pip install --quiet --disable-pip-version-check --upgrade pip wheel
  info "Installing web/runtime dependencies"
  "$VENV/bin/python" -m pip install --quiet --disable-pip-version-check -r "$STAGE/requirements.txt"
  if [ "$IS_MAC_ARM" = 1 ]; then
    info "Installing MLX, mlx-audio and mlx-whisper (Apple Silicon)"
    if [ -n "${STUDIO_MLX_AUDIO_SPEC:-}" ]; then
      "$VENV/bin/python" -m pip install --quiet --disable-pip-version-check "$STUDIO_MLX_AUDIO_SPEC" "mlx-whisper>=0.4.3"
    else
      "$VENV/bin/python" -m pip install --quiet --disable-pip-version-check -r "$STAGE/requirements-mlx.txt"
    fi
    "$VENV/bin/python" -c 'import mlx.core as mx, mlx_whisper; from mlx_audio.tts.utils import load_model; print("    MLX", mx.__version__, "- Metal:", mx.metal.is_available())' \
      || die "MLX packages installed but failed to import."
  fi

  say "Installing application code"
  if [ -d "$APP_HOME/app" ]; then
    BACKUP="$APP_HOME/backups/app-$TS"
    mv "$APP_HOME/app" "$BACKUP"
    info "Previous code backed up to $BACKUP"
  fi
  mv "$STAGE" "$APP_HOME/app"
  STAGE=""
  SWAPPED=1
  install_launchers
  "$VENV/bin/python" -m pip freeze --disable-pip-version-check > "$APP_HOME/app/VERSIONS.lock"
  "$VENV/bin/python" -m compileall -q "$APP_HOME/app/studio" "$APP_HOME/app/tests" >/dev/null

  say "Database and settings"
  (cd "$APP_HOME/app" && AUDIOBOOK_STUDIO_HOME="$APP_HOME" "$VENV/bin/python" -m studio migrate) | sed 's/^/    /'
  if [ "$LAN" = 1 ]; then
    [ -n "$HOST" ] || HOST="0.0.0.0"
    [ -n "$PORT" ] || PORT="8080"
  fi
  if [ -n "$HOST" ] || [ -n "$PORT" ]; then
    case "$HOST" in ""|127.0.0.1|localhost) REMOTE=0 ;; *) REMOTE=1 ;; esac
    set_server_settings "$HOST" "$PORT" "$REMOTE"
    info "Server: host=${HOST:-unchanged} port=${PORT:-unchanged}"
  fi
  GENERATED_PW=""
  if [ "$LAN" = 1 ] || [ -n "$HOST" ]; then ensure_admin; fi
  SWAPPED=0  # from here on the new code is committed
  # keep the five most recent code backups
  # shellcheck disable=SC2012
  { ls -1dt "$APP_HOME"/backups/app-* 2>/dev/null || true; } | tail -n +6 | while IFS= read -r old; do rm -rf "$old"; done

  if [ "$SKIP_TESTS" = 0 ]; then
    say "Running the automated test suite (mock engine, temporary data)"
    local tlog="$APP_HOME/logs/install-tests-$TS.log"
    if "$APP_HOME/run-tests" >"$tlog" 2>&1; then
      info "$(tail -n 1 "$tlog")"
    else
      warn "Some automated tests failed - see $tlog. The studio is installed; please report the log."
    fi
  fi

  say "Environment check"
  "$APP_HOME/studio" doctor | sed 's/^/    /' || warn "The environment check reported problems (see above)."

  if [ "$IS_MAC_ARM" = 1 ] && [ "$NO_MODELS" = 0 ]; then prefetch_models; fi

  local port host
  port="$("$VENV/bin/python" -c 'import json,sys; print(json.load(open(sys.argv[1])).get("server",{}).get("port",7861))' "$APP_HOME/config/settings.json")"
  host="$("$VENV/bin/python" -c 'import json,sys; print(json.load(open(sys.argv[1])).get("server",{}).get("host","127.0.0.1"))' "$APP_HOME/config/settings.json")"
  if [ "$INSTALL_SERVICE" = 1 ]; then
    say "Installing the background service"
    "$APP_HOME/studio-service" install
  fi
  printf '\n%sAudiobook Studio %s is installed.%s\n\n' "$G" "$STUDIO_VERSION" "$N"
  cat <<EOF
  Start the studio:      cd "$APP_HOME" && ./start-studio
  Then open:             http://127.0.0.1:$port   (this Mac)
$(if [ "$host" != "127.0.0.1" ]; then for ip in $(lan_addresses); do echo "  On your network:       http://$ip:$port   (sign-in required)"; done; echo "  By name:               http://$(hostname):$port"; fi)
$(if [ -n "$GENERATED_PW" ]; then echo "  First sign-in:         user '$ADMIN_USER'  password '$GENERATED_PW'   (also in config/initial-admin-password.txt)"; fi)
  Background service:   ./studio-service install | start | stop | restart | status | logs
  Stop:                  ./stop-studio
  Command line:          ./studio doctor | list | import | run | issues | approve | report | export
  Automated tests:       ./run-tests          (mock engine)
  Real GPU smoke test:   ./smoke-test         (Apple Silicon, real Qwen3-TTS + Whisper)

  Library (audio):       $APP_HOME/library    (change in Settings & Storage, e.g. /Volumes/YourSSD/Library)
  Database & settings:   $APP_HOME/data, $APP_HOME/config
  Model cache:           $HF_HOME
  Documentation:         $APP_HOME/README.md
EOF
}

main "$@"
