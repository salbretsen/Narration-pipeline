#!/bin/bash
# =============================================================================
#  Audiobook Studio - user-space setup for Apple Silicon Macs (no prerequisites)
#  Developed by Scott Albretsen, TSAL Solutions LLC
#  Version @@VERSION@@ (build @@BUILD_ID@@)
#
#  WHAT THIS DOES (read it; it is a plain, inspectable shell script - never pipe it into a shell unseen):
#    * installs into your home folder only. No sudo, no administrator password, no /usr/local, no /opt/homebrew, no shell profile edits.
#    * downloads, over HTTPS and verified against SHA-256 values pinned inside this file BEFORE anything is unpacked or run:
#        uv (the Python manager, from astral-sh/uv), FFmpeg + FFprobe (static builds from ffmpeg.martin-riedl.de),
#        a private Python 3.12 (fetched by the pinned uv), and hash-locked Python wheels from PyPI (prebuilt wheels only).
#    * registers a per-user LaunchAgent so the studio starts at login without Terminal (http://127.0.0.1:<port>).
#    * keeps your books, voices, settings, queue and model cache outside the replaceable application folders.
#    It needs none of: Homebrew, Git, Python, pip, Node, Rust, Docker, Xcode or the Command Line Tools.
#
#  Usage:   bash install_audiobook_studio_mac.sh [options]        (see --help)
#  Safe to re-run: finished steps are skipped, interrupted downloads resume, existing data is never removed.
#
#  Honest limits: this is a shell installer, not a signed/notarized app. It does not disable Gatekeeper, clear quarantine flags or
#  change any macOS security setting. Files fetched with curl carry no quarantine flag; the FFmpeg and uv binaries are published
#  by their authors (FFmpeg's as signed). If macOS ever shows a prompt for one of them, follow the prompt: this project will never
#  tell you to bypass it. Generated by tools/build_installer.py - edit the sources, not this file.
# =============================================================================
set -Eeuo pipefail
umask 022

STUDIO_VERSION="@@VERSION@@"
STUDIO_VERSION="${STUDIO_VERSION#v}"   # release directories and the update pointer use the bare version
BUILD_ID="@@BUILD_ID@@"

# ---- release-pinned bootstrap artifacts (generated from tools/runtime-manifest.json) ----
@@RUNTIME_PINS@@

ROOT="${AUDIOBOOK_STUDIO_ROOT:-$HOME/Library/Application Support/Audiobook Studio}"
LOGS="${AUDIOBOOK_STUDIO_LOGS:-$HOME/Library/Logs/Audiobook Studio}"
LIBRARY=""
MODEL_CACHE=""
PORT=""
LOCAL_ONLY=0
ASSUME_YES=0
CHECK_ONLY=0
DOWNLOAD_MODELS=""      # "", yes, all, no
MIGRATE_FROM=""
KEEP_NETWORK=0
NO_SERVICE=0
UNINSTALL=0
PURGE_APP=0
PURGE_DATA=0
EXTRACT_ONLY=""
ADMIN_USER="admin"
FORCE_DOWNGRADE=0

usage() {
  cat <<'USAGE'
Audiobook Studio setup (macOS, Apple Silicon)

  bash install_audiobook_studio_mac.sh [options]

Where things go
  --root DIR           Application root (default: ~/Library/Application Support/Audiobook Studio)
  --library DIR        Where books, voice samples, segments, masters and exports live (may be an external disk,
                       e.g. /Volumes/AudioSSD/Audiobooks). Default: <root>/library
  --model-cache DIR    Where model weights are cached (separate from the library; may be external).
                       Default: <root>/models/huggingface
  --port N             Web console port (default 7861; the next free port is used if it is busy)

What to download
  --download-models    Fetch the two default model weights now (about 6 GB). Otherwise they download on first use.
  --prefetch-all       Fetch all four models now (about 14 GB).
  --no-models          Never ask; models download on first use.

Other
  --migrate-from DIR   Adopt an old Bash/Homebrew installation (usually ~/audiobook-studio-claude). Its data is copied and
                       backed up, the new backend is tested, and only then is the old service replaced. The old folder is kept.
  --keep-network       With --migrate-from: keep serving the LAN if the old install did (default: this Mac only)
  --local-only         Serve this Mac only (127.0.0.1). Default for a new install: serve the LAN (HTTP and HTTPS); sign-in is always required.
  --admin-user NAME    Name of the first administrator (default: admin). A random password is shown once.
  --no-service         Install but do not register the login service.
  --check              Run the pre-flight checks and stop. Changes nothing.
  --yes                Do not ask questions; use defaults and flags.
  --uninstall          Remove the login service. Add --purge-app to also delete the application files (never your data).
                       --purge-data additionally deletes books, settings and models after you type a confirmation phrase.
  --force-downgrade    Allow installing an older version over a newer one.
  --extract-only DIR   Only write the embedded application files to DIR (for inspection).
  -h, --help           This help.

Environment: AUDIOBOOK_STUDIO_ROOT, AUDIOBOOK_STUDIO_LOGS override the default locations.
USAGE
}

need_val() { [ $# -ge 2 ] || { echo "$1 needs a value" >&2; exit 2; }; }
while [ $# -gt 0 ]; do
  case "$1" in
    --root) need_val "$@"; ROOT="$2"; shift ;;
    --library) need_val "$@"; LIBRARY="$2"; shift ;;
    --model-cache) need_val "$@"; MODEL_CACHE="$2"; shift ;;
    --port) need_val "$@"; PORT="$2"; shift
      case "$PORT" in ''|*[!0-9]*) echo "--port must be a number" >&2; exit 2 ;; esac
      if [ "$PORT" -lt 1024 ] || [ "$PORT" -gt 65535 ]; then echo "--port must be 1024-65535" >&2; exit 2; fi ;;
    --download-models) DOWNLOAD_MODELS="yes" ;;
    --prefetch-all) DOWNLOAD_MODELS="all" ;;
    --no-models) DOWNLOAD_MODELS="no" ;;
    --migrate-from) need_val "$@"; MIGRATE_FROM="$2"; shift ;;
    --keep-network) KEEP_NETWORK=1 ;;
    --local-only) LOCAL_ONLY=1 ;;
    --admin-user) need_val "$@"; ADMIN_USER="$2"; shift ;;
    --no-service) NO_SERVICE=1 ;;
    --check) CHECK_ONLY=1 ;;
    --yes|-y) ASSUME_YES=1 ;;
    --uninstall) UNINSTALL=1 ;;
    --purge-app) PURGE_APP=1 ;;
    --purge-data) PURGE_DATA=1 ;;
    --force-downgrade) FORCE_DOWNGRADE=1 ;;
    --extract-only) need_val "$@"; EXTRACT_ONLY="$2"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

if [ -t 1 ]; then B=$'\033[1m'; BL=$'\033[1;34m'; Y=$'\033[1;33m'; R=$'\033[1;31m'; G=$'\033[1;32m'; N=$'\033[0m'; else B=""; BL=""; Y=""; R=""; G=""; N=""; fi
say()  { printf '\n%s==>%s %s%s%s\n' "$BL" "$N" "$B" "$*" "$N"; }
info() { printf '    %s\n' "$*"; }
ok()   { printf '    %s✓%s %s\n' "$G" "$N" "$*"; }
warn() { printf '%sWarning:%s %s\n' "$Y" "$N" "$*" >&2; }
die()  { printf '%sError:%s %s\n' "$R" "$N" "$*" >&2; exit 1; }
interactive() { [ "$ASSUME_YES" = 0 ] && [ -t 0 ] && [ -t 1 ]; }
ask_yn() {  # ask_yn "question" default(y|n)
  local q="$1" d="${2:-n}" a
  if ! interactive; then [ "$d" = "y" ]; return; fi
  read -r -p "    $q [$([ "$d" = y ] && echo Y/n || echo y/N)] " a || a=""
  case "${a:-$d}" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}
ask_path() {  # ask_path "prompt" default -> echoes the chosen path
  local q="$1" d="$2" a
  if ! interactive; then echo "$d"; return; fi
  read -r -p "    $q [$d] " a || a=""
  echo "${a:-$d}"
}
# shellcheck disable=SC2088  # a literal "~" typed by the user is deliberately matched, not expanded here
expand() { case "$1" in "~") echo "$HOME" ;; "~/"*) echo "$HOME/${1#\~/}" ;; *) echo "$1" ;; esac; }

# ----------------------------------------------------------------------------- embedded application files
extract_files() {
  local DEST="$1"
  mkdir -p "$DEST"
@@EMBEDDED_FILES@@
}

# macOS ships /usr/bin/shasum. The fallbacks only exist so --extract-only can be used to inspect this file on another machine.
sha_tool() {
  if [ -x /usr/bin/shasum ]; then /usr/bin/shasum -a 256 "$@"
  elif command -v sha256sum >/dev/null 2>&1; then sha256sum "$@"
  else shasum -a 256 "$@"; fi
}

verify_manifest() {
  local dir="$1"
  ( cd "$dir" && sha_tool -c MANIFEST.sha256 >/dev/null 2>&1 )
}

if [ -n "$EXTRACT_ONLY" ]; then
  extract_files "$EXTRACT_ONLY/app"
  verify_manifest "$EXTRACT_ONLY/app" || die "Integrity check of the extracted files failed."
  echo "Application files written to $EXTRACT_ONLY/app (integrity verified)."
  exit 0
fi

# ----------------------------------------------------------------------------- helpers
sha256_of() { sha_tool "$1" | awk '{print $1}'; }
file_size() { /usr/bin/stat -f %z "$1"; }
free_gb() {  # free GB on the volume holding $1 (walks up to an existing parent)
  local p="$1"
  while [ ! -e "$p" ] && [ "$p" != "/" ]; do p="$(dirname "$p")"; done
  /bin/df -Pk "$p" | awk 'NR==2 {printf "%d", $4/1048576}'
}
volume_of() { case "$1" in /Volumes/*) echo "/Volumes/$(echo "$1" | cut -d/ -f3)" ;; *) echo "" ;; esac; }
port_busy() { /usr/bin/nc -z 127.0.0.1 "$1" >/dev/null 2>&1; }

# Download URL to DEST and require SIZE and SHA256. Resumes DEST.part; a finished, verified file is never fetched again.
fetch_pinned() {
  local url="$1" dest="$2" want_sha="$3" want_size="$4" label="$5"
  mkdir -p "$(dirname "$dest")"
  if [ -f "$dest" ] && [ "$(sha256_of "$dest")" = "$want_sha" ]; then ok "$label already downloaded and verified"; return 0; fi
  rm -f "$dest"
  local part="$dest.part" tries=0
  [ -f "$part" ] && [ "$(file_size "$part")" -gt "$want_size" ] && rm -f "$part"
  info "Downloading $label ($((want_size / 1048576)) MB) ..."
  while [ "$tries" -lt 3 ]; do
    tries=$((tries + 1))
    if [ -f "$part" ] && [ "$(file_size "$part")" = "$want_size" ]; then break; fi
    /usr/bin/curl --proto '=https' --proto-redir '=https' --tlsv1.2 --fail --location --connect-timeout 20 --max-time 1800 \
      --max-filesize "$((want_size + 1048576))" -C - -sS --retry 2 -o "$part" "$url" || { warn "download attempt $tries failed (partial data kept for resume)"; sleep 2; continue; }
    break
  done
  [ -f "$part" ] || die "Could not download $label from $url. Check your internet connection and run this installer again; it resumes."
  [ "$(file_size "$part")" = "$want_size" ] || die "$label is $(file_size "$part") bytes, expected $want_size. Run the installer again to resume."
  local got
  got="$(sha256_of "$part")"
  if [ "$got" != "$want_sha" ]; then
    rm -f "$part"
    die "SECURITY CHECK FAILED for $label: SHA-256 is $got but this installer pins $want_sha. The file was deleted and NOTHING was installed or run."
  fi
  mv "$part" "$dest"
  ok "$label verified (SHA-256 $want_sha)"
}

# ----------------------------------------------------------------------------- uninstall
if [ "$UNINSTALL" = 1 ]; then
  say "Removing the Audiobook Studio login service"
  PY="$ROOT/app/venv/bin/python"
  if [ -x "$PY" ] && [ -d "$ROOT/app/current" ]; then
    AUDIOBOOK_STUDIO_ROOT="$ROOT" "$ROOT/audiobook-studio" service uninstall || true
  else
    UID_N="$(id -u)"
    /bin/launchctl bootout "gui/$UID_N/com.audiobookstudio.app" 2>/dev/null || true
    rm -f "$HOME/Library/LaunchAgents/com.audiobookstudio.app.plist"
  fi
  ok "service removed (your books, settings and models were not touched)"
  if [ "$PURGE_APP" = 1 ]; then
    say "Deleting application files in $ROOT/app (releases, runtime, tools)"
    rm -rf "$ROOT/app" "$ROOT/audiobook-studio"
    ok "application files deleted"
  fi
  if [ "$PURGE_DATA" = 1 ]; then
    echo
    warn "This permanently deletes $ROOT/state (database, settings, accounts) and $ROOT/models. Library folders you chose elsewhere are NOT deleted."
    printf '    Type exactly  delete my audiobook data  to confirm: '
    read -r phrase || phrase=""
    if [ "$phrase" = "delete my audiobook data" ]; then rm -rf "$ROOT/state" "$ROOT/models"; ok "data deleted"; else info "Not confirmed. Nothing deleted."; fi
  fi
  exit 0
fi

# ----------------------------------------------------------------------------- pre-flight
FAILS=0; WARNS=0
pf_ok()   { ok "$*"; }
pf_warn() { WARNS=$((WARNS + 1)); printf '    %s!%s %s\n' "$Y" "$N" "$*"; }
pf_fail() { FAILS=$((FAILS + 1)); printf '    %s✗%s %s\n' "$R" "$N" "$*"; }

preflight() {
  say "Pre-flight checks (nothing has been changed yet)"
  local os arch ver major mem_gb
  os="$(uname -s)"; arch="$(uname -m)"
  if [ "$os" != "Darwin" ]; then die "This installer is for macOS on Apple Silicon (found $os). Windows and Linux are not supported yet. Nothing was changed."; fi
  ver="$(/usr/bin/sw_vers -productVersion)"; major="${ver%%.*}"
  if [ "$major" -ge "$MIN_MACOS_MAJOR" ] 2>/dev/null; then pf_ok "macOS $ver"; else pf_fail "macOS $MIN_MACOS_MAJOR or later is required (this Mac runs $ver). MLX needs it."; fi
  if [ "$(/usr/sbin/sysctl -n sysctl.proc_translated 2>/dev/null || echo 0)" = "1" ]; then
    pf_fail "This Terminal runs under Rosetta (x86_64 emulation). Open a native Terminal (Get Info > untick 'Open using Rosetta') and run again."
  elif [ "$arch" = "arm64" ]; then pf_ok "Apple Silicon (arm64): $(/usr/sbin/sysctl -n machdep.cpu.brand_string 2>/dev/null || echo M-series)"
  else pf_fail "Apple Silicon is required for local inference; this Mac reports $arch."; fi
  mem_gb=$(( $(/usr/sbin/sysctl -n hw.memsize) / 1073741824 ))
  if [ "$mem_gb" -ge 32 ]; then pf_ok "${mem_gb} GB unified memory"; elif [ "$mem_gb" -ge 16 ]; then pf_warn "${mem_gb} GB memory: keep Settings > Models > 'Models kept loaded' at 1."; else pf_fail "${mem_gb} GB memory is too little for the 1.7B models (16 GB minimum, 32 GB recommended)."; fi
  for t in /usr/bin/curl /usr/bin/tar /usr/bin/unzip /usr/bin/shasum /usr/bin/nc /bin/launchctl; do
    [ -x "$t" ] && continue
    pf_fail "macOS tool missing: $t"
  done
  # disk space, per location
  local need_root=5 need_models=7 need_lib=20 g
  [ "$DOWNLOAD_MODELS" = "all" ] && need_models=15
  g="$(free_gb "$ROOT")"
  if [ "$g" -ge "$need_root" ]; then pf_ok "$g GB free for the application (needs about $need_root GB: Python environment, tools, releases) at $ROOT"; else pf_fail "Only $g GB free for the application at $ROOT; about $need_root GB are needed."; fi
  g="$(free_gb "$MODEL_CACHE")"
  if [ "$g" -ge "$need_models" ]; then pf_ok "$g GB free for model weights (about $need_models GB) at $MODEL_CACHE"; else pf_warn "Only $g GB free at the model cache $MODEL_CACHE; the default models need about $need_models GB. Choose another disk with --model-cache."; fi
  g="$(free_gb "$LIBRARY")"
  if [ "$g" -ge "$need_lib" ]; then pf_ok "$g GB free for your library at $LIBRARY"; else pf_warn "Only $g GB free at $LIBRARY. A finished audiobook needs several GB of working audio."; fi
  # external volumes and writability
  local p v
  for p in "$ROOT" "$LIBRARY" "$MODEL_CACHE"; do
    v="$(volume_of "$p")"
    if [ -n "$v" ] && [ ! -d "$v" ]; then pf_fail "The disk $v is not connected, so $p is unavailable. Connect it and run this installer again."; continue; fi
    local probe="$p"; while [ ! -e "$probe" ] && [ "$probe" != "/" ]; do probe="$(dirname "$probe")"; done
    if [ -w "$probe" ]; then pf_ok "writable: $p"; else pf_fail "Not writable: $probe. Pick a folder you own, or check System Settings > Privacy & Security > Files and Folders for external volumes."; fi
  done
  # network (HEAD requests only; nothing is downloaded)
  local h
  for h in "$UV_URL" "$FFMPEG_URL" "https://pypi.org/simple/"; do
    if /usr/bin/curl --proto '=https' --tlsv1.2 -sS -I -L --connect-timeout 15 --max-time 30 -o /dev/null "$h" 2>/dev/null; then pf_ok "reachable: $(echo "$h" | cut -d/ -f3)"; else pf_fail "Cannot reach $(echo "$h" | cut -d/ -f3). Check your connection, proxy or firewall."; fi
  done
  # port
  if [ -n "$MIGRATE_FROM" ]; then pf_ok "port check skipped (the old service may still own it until the switch)"
  elif port_busy "${PORT:-7861}" && [ -n "$PORT" ]; then pf_fail "Port $PORT is in use. Pick another with --port."
  elif port_busy 7861 && [ -z "$PORT" ]; then
    local p2=7862; while port_busy "$p2" && [ "$p2" -lt 7900 ]; do p2=$((p2 + 1)); done
    PORT="$p2"; pf_warn "Port 7861 is busy; using $PORT."
  else pf_ok "port ${PORT:-7861} is free"; fi
  if [ "$FAILS" -gt 0 ]; then echo; die "$FAILS pre-flight check(s) failed (see the lines marked ✗). Nothing was changed."; fi
  [ "$WARNS" -gt 0 ] && info "$WARNS warning(s) above; the install can continue."
  return 0
}

MIN_MACOS_MAJOR="${MIN_MACOS%%.*}"

# ----------------------------------------------------------------------------- installation steps
install_tools() {
  say "Preparing private tools in $ROOT/app/tools (uv, FFmpeg, FFprobe)"
  local dl="$ROOT/app/downloads" bin="$ROOT/app/tools/bin" tmp
  mkdir -p "$dl" "$bin"
  if [ ! -x "$bin/uv" ] || [ "$(cat "$bin/.uv-version" 2>/dev/null)" != "$UV_VERSION" ]; then
    fetch_pinned "$UV_URL" "$dl/uv-$UV_VERSION.tar.gz" "$UV_SHA256" "$UV_SIZE" "uv $UV_VERSION"
    tmp="$(mktemp -d "$ROOT/app/.unpack.XXXXXX")"
    /usr/bin/tar -xzf "$dl/uv-$UV_VERSION.tar.gz" -C "$tmp" "$UV_MEMBER"
    cp "$tmp/$UV_MEMBER" "$bin/uv.new"; chmod 755 "$bin/uv.new"; mv "$bin/uv.new" "$bin/uv"
    echo "$UV_VERSION" > "$bin/.uv-version"
    rm -rf "$tmp"
  else ok "uv $UV_VERSION already installed"; fi
  local t
  for t in ffmpeg ffprobe; do
    local v u s z m
    if [ "$t" = ffmpeg ]; then v="$FFMPEG_VERSION"; u="$FFMPEG_URL"; s="$FFMPEG_SHA256"; z="$FFMPEG_SIZE"; m="$FFMPEG_MEMBER"
    else v="$FFPROBE_VERSION"; u="$FFPROBE_URL"; s="$FFPROBE_SHA256"; z="$FFPROBE_SIZE"; m="$FFPROBE_MEMBER"; fi
    if [ -x "$bin/$t" ] && [ "$(cat "$bin/.$t-version" 2>/dev/null)" = "$v" ]; then ok "$t $v already installed"; continue; fi
    fetch_pinned "$u" "$dl/$t-$v.zip" "$s" "$z" "$t $v"
    tmp="$(mktemp -d "$ROOT/app/.unpack.XXXXXX")"
    /usr/bin/unzip -q -o "$dl/$t-$v.zip" "$m" -d "$tmp"
    cp "$tmp/$m" "$bin/$t.new"; chmod 755 "$bin/$t.new"; mv "$bin/$t.new" "$bin/$t"
    echo "$v" > "$bin/.$t-version"
    rm -rf "$tmp"
  done
  # prove the tools run and can encode the formats the studio exports (AAC for M4B, MP3)
  if ! "$bin/ffmpeg" -hide_banner -encoders 2>/dev/null | grep -q ' aac '; then die "The app-owned FFmpeg cannot encode AAC. Please report this build."; fi
  if ! "$bin/ffmpeg" -hide_banner -encoders 2>/dev/null | grep -q 'libmp3lame'; then die "The app-owned FFmpeg cannot encode MP3. Please report this build."; fi
  ok "FFmpeg $("$bin/ffmpeg" -version 2>/dev/null | head -n 1 | cut -c1-60): AAC (M4B) and MP3 encoders present"
  info "FFmpeg license: GPL-3.0-or-later build, downloaded from its publisher and run as a separate program (see tools/runtime-manifest.json)."
}

uv_env() {
  export UV_PYTHON_INSTALL_DIR="$ROOT/app/python" UV_PYTHON_BIN_DIR="$ROOT/app/python-bin" UV_CACHE_DIR="$ROOT/app/uv-cache"
  export UV_PYTHON_PREFERENCE=only-managed UV_NO_CONFIG=1 UV_NO_PROGRESS=1 UV_LINK_MODE=copy
}

install_release() {
  say "Installing Audiobook Studio $STUDIO_VERSION"
  local rel="$ROOT/app/releases/$STUDIO_VERSION" stage
  # reuse only the very same build (a folder is always consistent with its own manifest, so that alone proves nothing about WHICH build it is)
  if [ -d "$rel" ] && [ "$(cat "$rel/BUILD" 2>/dev/null)" = "$BUILD_ID" ] && verify_manifest "$rel"; then ok "release $STUDIO_VERSION (build $BUILD_ID) already unpacked and verified"
  else
    stage="$ROOT/app/releases/.stage-$$"
    rm -rf "$stage"; mkdir -p "$ROOT/app/releases"
    extract_files "$stage"
    verify_manifest "$stage" || { rm -rf "$stage"; die "Integrity check of the embedded application files failed."; }
    rm -rf "$rel"; mv "$stage" "$rel"
    ok "unpacked and verified $(grep -c . "$rel/MANIFEST.sha256") files"
  fi
}

install_runtime() {
  say "Creating the private Python environment (Python $PY_REQUEST, prebuilt wheels only)"
  uv_env
  local rel="$ROOT/app/releases/$STUDIO_VERSION" lock id venv uv="$ROOT/app/tools/bin/uv"
  lock="$rel/requirements.lock"
  [ -f "$lock" ] || die "requirements.lock is missing from this build; refusing to install unlocked, unverified dependencies."
  id="$(sha_tool "$lock" | cut -c1-16)"
  venv="$ROOT/app/runtimes/$id/venv"
  if [ -f "$ROOT/app/runtimes/$id/.complete" ] && "$venv/bin/python" -c 'import mlx.core, fastapi' >/dev/null 2>&1; then ok "environment $id already complete"
  else
    # built in place (a venv records its own absolute path) and marked complete only at the very end
    rm -rf "$ROOT/app/runtimes/$id"; mkdir -p "$ROOT/app/runtimes/$id"
    info "Fetching Python $PY_REQUEST (digest checked by uv) ..."
    "$uv" python install "$PY_REQUEST" --no-bin
    "$uv" venv --python "$PY_REQUEST" --python-preference only-managed "$venv"
    info "Installing locked packages (about 1-2 GB; prebuilt wheels only, every file hash-checked) ..."
    if ! "$uv" pip install --python "$venv/bin/python" --require-hashes --only-binary :all: -r "$lock"; then
      rm -rf "$ROOT/app/runtimes/$id"
      die "A dependency could not be installed from a prebuilt wheel. This is a packaging defect, not something to fix by installing developer tools. Nothing else was changed; please report it with the lines above."
    fi
    : > "$ROOT/app/runtimes/$id/.complete"
    ok "environment $id ready"
  fi
  PY="$venv/bin/python"
  ln -sfn "$venv" "$ROOT/app/venv.new" && mv -f -h "$ROOT/app/venv.new" "$ROOT/app/venv"
  info "Checking Apple Silicon / MLX compatibility ..."
  if "$PY" -c 'import mlx.core as mx, sys; sys.exit(0 if mx.metal.is_available() else 3)' 2>/dev/null; then ok "MLX imports and Metal is available"
  else die "MLX could not use the GPU on this Mac (Metal unavailable or MLX failed to import). Apple Silicon with macOS $MIN_MACOS or later is required."; fi
}

activate_release() {
  # newer-than-this check, then atomic pointer switch, using the application's own tested code
  local rel="$ROOT/app/releases/$STUDIO_VERSION" r
  r="$(AUDIOBOOK_STUDIO_ROOT="$ROOT" PYTHONPATH="$rel" PYTHONDONTWRITEBYTECODE=1 "$PY" - "$STUDIO_VERSION" "$FORCE_DOWNGRADE" "$PY" <<'PYEOF'
import sys
from pathlib import Path
from studio.update.layout import Layout
from studio.update.manifest import parse_version
from studio.update.store import ReleaseStore
ver, force = sys.argv[1], sys.argv[2] == "1"
lay = Layout.discover(); store = ReleaseStore(lay); cur = store.current()
if cur and parse_version(cur) > parse_version(ver) and not force:
    print("NEWER " + cur); raise SystemExit(0)
store.activate(ver); store.link_python(Path(sys.argv[3]))
print("OK")
PYEOF
)"
  case "$r" in
    NEWER*) die "A newer version (${r#NEWER }) is already installed here; updates are managed inside the app (Updates page). Use --force-downgrade to install $STUDIO_VERSION anyway." ;;
    OK) ok "version $STUDIO_VERSION is now the active release" ;;
    *) die "Could not activate the release: $r" ;;
  esac
}

install_launcher() {
  cp "$ROOT/app/releases/$STUDIO_VERSION/bin/audiobook-studio" "$ROOT/audiobook-studio.new"
  chmod 755 "$ROOT/audiobook-studio.new"; mv -f "$ROOT/audiobook-studio.new" "$ROOT/audiobook-studio"
  ok "command line: $ROOT/audiobook-studio"
}

studio() { AUDIOBOOK_STUDIO_ROOT="$ROOT" AUDIOBOOK_STUDIO_LOGS="$LOGS" "$ROOT/audiobook-studio" "$@"; }

configure_state() {
  say "Creating your data folders and settings (existing ones are kept)"
  mkdir -p "$ROOT/state" "$LOGS" "$LIBRARY" "$MODEL_CACHE"
  local fresh=1
  [ -f "$ROOT/state/config/settings.json" ] && fresh=0
  set -- configure
  if [ "$fresh" = 1 ] || [ -n "$LIBRARY_FLAG" ]; then set -- "$@" --library "$LIBRARY"; fi
  if [ "$fresh" = 1 ] || [ -n "$MODEL_FLAG" ]; then set -- "$@" --model-cache "$MODEL_CACHE"; fi
  if [ -n "$PORT" ]; then set -- "$@" --port "$PORT"; fi
  if [ "$LOCAL_ONLY" = 1 ]; then set -- "$@" --local-only; elif [ "$fresh" = 1 ] && [ -z "$MIGRATE_FROM" ]; then set -- "$@" --lan; fi
  studio "$@"
  ensure_admin
}

ensure_admin() {
  local users
  users="$(studio auth list 2>/dev/null | wc -l | tr -d ' ')"
  if [ "$users" = "0" ]; then
    local out pw pwfile="$ROOT/state/config/initial-admin-password.txt"
    out="$(studio auth add-user "$ADMIN_USER" --role admin --generate)"
    pw="${out##*Generated password: }"
    ( umask 077; printf 'user: %s\npassword: %s\n(delete this file once you have stored the password; change it in the web console)\n' "$ADMIN_USER" "$pw" > "$pwfile" )
    GENERATED_PW="$pw"
    ok "created administrator '$ADMIN_USER' (initial password saved to $pwfile, mode 600)"
  else ok "existing user accounts kept ($users)"; fi
}

prefetch_models() {
  local mode="$1"
  say "Downloading model weights ($([ "$mode" = all ] && echo '~14 GB' || echo '~6 GB'); resumable; public Hugging Face repositories)"
  local ids
  ids="$(AUDIOBOOK_STUDIO_ROOT="$ROOT" AUDIOBOOK_STUDIO_HOME="$ROOT/state" "$PY" - "$mode" <<'PYEOF'
import json, sys
m = json.load(open(__import__("os").environ["AUDIOBOOK_STUDIO_HOME"] + "/config/settings.json")).get("models", {})
ids = [m.get("custom_voice_model", "mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-bf16"), m.get("asr_model", "mlx-community/whisper-large-v3-turbo")]
if sys.argv[1] == "all":
    ids += [m.get("base_model", "mlx-community/Qwen3-TTS-12Hz-1.7B-Base-bf16"), m.get("voice_design_model", "mlx-community/Qwen3-TTS-12Hz-1.7B-VoiceDesign-bf16")]
print(" ".join(i for i in ids if not i.startswith("/")))
PYEOF
)"
  # shellcheck disable=SC2086
  if HF_HOME="$MODEL_CACHE" HF_HUB_DISABLE_TELEMETRY=1 "$PY" - $ids <<'PYEOF'
import sys, time
from huggingface_hub import snapshot_download
for repo in sys.argv[1:]:
    t0 = time.time(); print(f"    fetching {repo} ...", flush=True)
    print(f"    ok ({time.time() - t0:.0f}s): {snapshot_download(repo)}", flush=True)
PYEOF
  then ok "model weights are in $MODEL_CACHE"
  else warn "The model download did not finish (network or disk?). The studio downloads models on first use; you can also re-run this installer."; fi
}

install_service() {
  say "Registering the login service (a per-user LaunchAgent; no administrator rights)"
  studio service install
  local p tries=0
  p="$(AUDIOBOOK_STUDIO_HOME="$ROOT/state" "$PY" -c 'import json,sys;print(json.load(open(sys.argv[1])).get("server",{}).get("port",7861))' "$ROOT/state/config/settings.json")"
  PORT="$p"
  info "Waiting for the studio to answer on http://127.0.0.1:$p ..."
  while [ "$tries" -lt 90 ]; do
    if /usr/bin/curl -fsS -m 3 "http://127.0.0.1:$p/healthz" 2>/dev/null | grep -q '"ok":true'; then ok "the studio is running (version $(/usr/bin/curl -fsS "http://127.0.0.1:$p/healthz" | sed -n 's/.*"version":"\([^"]*\)".*/\1/p'))"; return 0; fi
    tries=$((tries + 1)); sleep 2
  done
  tail -n 30 "$LOGS/launchd.out.log" 2>/dev/null || true
  die "The service did not become healthy in 3 minutes. Logs: $LOGS. Run  $ROOT/audiobook-studio doctor"
}

# ----------------------------------------------------------------------------- main
main() {
  say "Audiobook Studio $STUDIO_VERSION setup (build $BUILD_ID)"
  ROOT="$(expand "$ROOT")"
  LIBRARY_FLAG="$LIBRARY"; MODEL_FLAG="$MODEL_CACHE"
  if [ -z "$MIGRATE_FROM" ] && [ -d "$HOME/audiobook-studio-claude/config" ] && [ ! -d "$ROOT/state/data" ]; then
    info "Found an older installation at $HOME/audiobook-studio-claude."
    if ask_yn "Adopt it (copy its data; it stays untouched and is backed up first)?" n; then MIGRATE_FROM="$HOME/audiobook-studio-claude"; fi
  fi
  if [ -n "$MIGRATE_FROM" ]; then MIGRATE_FROM="$(expand "$MIGRATE_FROM")"; [ -d "$MIGRATE_FROM/config" ] || die "$MIGRATE_FROM is not an Audiobook Studio installation."; fi
  # where to put things: ask before any large download
  if [ -z "$LIBRARY" ]; then
    LIBRARY="$ROOT/library"
    if [ -z "$MIGRATE_FROM" ]; then LIBRARY="$(ask_path "Where should your books and audio be stored (a folder on any disk, e.g. /Volumes/AudioSSD/Audiobooks)?" "$LIBRARY")"; LIBRARY_FLAG="$LIBRARY"; fi
  fi
  if [ -z "$MODEL_CACHE" ]; then
    MODEL_CACHE="$ROOT/models/huggingface"
    if [ -z "$MIGRATE_FROM" ]; then MODEL_CACHE="$(ask_path "Where should model weights be cached (needs 7-15 GB)?" "$MODEL_CACHE")"; MODEL_FLAG="$MODEL_CACHE"; fi
  fi
  LIBRARY="$(expand "$LIBRARY")"; MODEL_CACHE="$(expand "$MODEL_CACHE")"
  [ -n "$LIBRARY_FLAG" ] && LIBRARY_FLAG="$LIBRARY"; [ -n "$MODEL_FLAG" ] && MODEL_FLAG="$MODEL_CACHE"
  [ -n "$MIGRATE_FROM" ] && { LIBRARY_FLAG=""; MODEL_FLAG=""; }
  # the download question comes after the locations are known and before anything large is fetched
  if [ -z "$DOWNLOAD_MODELS" ]; then
    if [ "$CHECK_ONLY" = 1 ]; then DOWNLOAD_MODELS="no"
    elif [ -n "$MIGRATE_FROM" ]; then DOWNLOAD_MODELS="no"; info "Models: the old installation's cache is reused in place; nothing is downloaded now."
    elif ask_yn "Download the two default models now (about 6 GB)? Otherwise they download the first time you narrate." n; then DOWNLOAD_MODELS="yes"; else DOWNLOAD_MODELS="no"; fi
  fi
  preflight
  if [ "$CHECK_ONLY" = 1 ]; then say "Pre-flight complete. Nothing was installed."; exit 0; fi

  mkdir -p "$ROOT/app" "$LOGS"
  LOCK="$ROOT/app/.install.lock"
  mkdir "$LOCK" 2>/dev/null || die "Another installation seems to be running (remove $LOCK if not)."
  trap 'rmdir "$LOCK" 2>/dev/null || true' EXIT
  exec > >(tee -a "$LOGS/install-$(date +%Y%m%d-%H%M%S).log") 2>&1

  install_tools
  install_release
  install_runtime
  activate_release
  install_launcher
  GENERATED_PW=""
  if [ -n "$MIGRATE_FROM" ]; then
    say "Adopting the old installation at $MIGRATE_FROM"
    studio configure --manifest-only
    if [ "$KEEP_NETWORK" = 1 ]; then studio migrate-legacy "$MIGRATE_FROM" --keep-network; else studio migrate-legacy "$MIGRATE_FROM"; fi
    NO_SERVICE=1
    PORT="$("$PY" -c 'import json,sys;print(json.load(open(sys.argv[1])).get("server",{}).get("port",7861))' "$ROOT/state/config/settings.json")"
    # the migrated settings own these now (the old library and model cache were kept in place)
    LIBRARY="$("$PY" -c 'import json,sys;print(json.load(open(sys.argv[1])).get("storage",{}).get("library_root") or "")' "$ROOT/state/config/settings.json")"
    MODEL_CACHE="$("$PY" -c 'import json,sys;print(json.load(open(sys.argv[1])).get("models",{}).get("cache_dir") or "")' "$ROOT/state/config/settings.json")"
  else
    configure_state
  fi
  case "$DOWNLOAD_MODELS" in yes) prefetch_models yes ;; all) prefetch_models all ;; *) info "Models will download on first use." ;; esac
  [ "$NO_SERVICE" = 1 ] || install_service

  say "Done"
  local url="http://127.0.0.1:${PORT:-7861}"
  cat <<EOF

    Audiobook Studio $STUDIO_VERSION is installed.

    Open it:        $url      (bookmark it)
    Dock icon:      in Safari open that address, then File > Add to Dock (macOS Sonoma 14 or later).
                    The Dock icon is just a web app; the studio itself keeps running in the background under macOS (launchd).
    Command line:   $ROOT/audiobook-studio doctor | start | stop | restart | logs | version | update --check
    Updates:        in the web console, Updates page (nothing is downloaded or installed without your click).
    Logs:           $LOGS
    Your data:      state    $ROOT/state
                    library  $LIBRARY
                    models   $MODEL_CACHE
EOF
  if [ -n "$GENERATED_PW" ]; then
    echo
    echo "    Sign in as '$ADMIN_USER' with the password saved in $ROOT/state/config/initial-admin-password.txt"
    echo "    (shown once here: $GENERATED_PW). Store it, then delete that file."
  fi
  echo
}

main "$@"
